{
  "name": "diya-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tinacms dev -c \"next dev\"",
    "build": "tinacms build && next build",
    "build:local": "tinacms dev -c \"node scripts/next-build.mjs\"",
    "start": "npx serve out",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "postinstall": "node scripts/patch-tina-windows.mjs"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tinacms": "^3.15.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@tinacms/cli": "^4.0.5",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.34",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2"
  }
}
