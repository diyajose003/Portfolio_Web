# Copy to .env for local cloud builds. On Cloudflare Pages, set these under Settings > Environment variables.
# From app.tina.io > your project > Overview. The client ID is public by design.
NEXT_PUBLIC_TINA_CLIENT_ID=
# From app.tina.io > your project > Tokens. Use a READ-ONLY content token. Keep it out of Git.
TINA_TOKEN=
# Live site address, used for search-engine and social-share tags.
NEXT_PUBLIC_SITE_URL=https://diya-jose.pages.dev
